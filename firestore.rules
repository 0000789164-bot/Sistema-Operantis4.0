rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sistema_operantis/dados {
      allow read: if request.auth != null;

      // O aplicativo usa autenticação anônima. Mantemos o acesso autenticado,
      // limitando a escrita ao documento realmente utilizado pelo app.
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'equipamentos', 'ordens', 'planejamento',
          'historico', 'falhasAutomaticas', 'atualizadoEm'
        ])
        && request.resource.data.equipamentos is list
        && request.resource.data.ordens is list
        && request.resource.data.planejamento is list
        && request.resource.data.historico is list
        && (
          !request.resource.data.keys().hasAny(['falhasAutomaticas'])
          || request.resource.data.falhasAutomaticas is list
        );

      allow delete: if false;
    }

    // Bloqueia documentos adicionais dentro da coleção.
    match /sistema_operantis/{document} {
      allow read, write: if false;
    }
  }
}
