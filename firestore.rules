rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sistema_operantis/dados {
      allow read: if request.auth != null;

      // O aplicativo usa autenticação anônima. Mantemos o acesso autenticado,
      // mas limitamos a escrita ao único documento realmente usado pelo app.
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'equipamentos', 'ordens', 'planejamento', 'historico',
          'falhasAutomaticas', 'atualizadoEm'
        ])
        && request.resource.data.equipamentos is list
        && request.resource.data.ordens is list
        && request.resource.data.planejamento is list
        && request.resource.data.historico is list
        && request.resource.data.falhasAutomaticas is list;

      allow delete: if false;
    }

    // Bloqueia documentos/coleções adicionais não utilizados pelo aplicativo.
    match /sistema_operantis/{document} {
      allow read, write: if false;
    }
  }
}
